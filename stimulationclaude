<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Stimulation Candidate Screening</title>

    <!-- Full script URLs: "https://plot.ly" and "https://jsdelivr.net" are websites, not scripts -->
    <script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"></script>
    <script src="common.js"></script>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<nav>
    <a href="index.html">Well Review</a>
    <a href="water_analysis.html">Water Analysis</a>
    <a href="stimulation_screening.html" class="active">Stimulation Screening</a>
</nav>

<h1>Well Stimulation Candidate Screening</h1>

<div id="errorBox"></div>

<label><b>Select Asset Well Bores:</b></label>
<select id="wellSelector"></select>

<div class="dashboard">
    <div class="card"><h3>Selected Well</h3><p id="wellName">Loading...</p></div>
    <div class="card"><h3>Downhole Pressure</h3><p id="avgBHP">-</p></div>
    <div class="card"><h3>Current Oil Rate</h3><p id="currentOil">-</p></div>
    <div class="card"><h3>Drawdown Status</h3><p id="drawdownStatus">-</p></div>
    <div class="card"><h3>Heterogeneity (latest month)</h3><p id="hiStatus">-</p></div>
</div>

<div id="screeningPlot" class="plot"></div>
<p class="note">Screening rule: a well is flagged when, on its last day of oil production, the daily average
downhole pressure is below <b>150 bar</b> and the oil rate is below <b>500 BOPD</b>. This is a simple
first-pass heuristic, not a skin or productivity-index calculation. Days where the downhole gauge reported 0
or nothing are treated as missing data and shown as gaps.</p>

<div id="heterogeneityPlot" class="plot"></div>
<p class="note">Heterogeneity index: HI = q<sub>well</sub> / q&#772;<sub>group</sub> &minus; 1, computed separately
for oil and water each calendar month. q<sub>well</sub> is the well's average rate on the days it produced that
month (so downtime does not count against it), and q&#772;<sub>group</sub> is the mean of that rate over all producers
active in the month. HI = 0 is the group average; HI = &minus;1 means no production of that phase. Months where the
selected well did not produce, or where fewer than two producers were active, are left out because there is no
group to compare against. Low oil with high water points to a water shut-off review; low oil with low water points
to a stimulation review. Grey points are every producer's monthly HI, for context.</p>

<footer>Data: Volve field daily production, Equinor open data release.</footer>

<script>
const BHP_LIMIT = 150;  // bar
const OIL_LIMIT = 500;  // BOPD

let allRows = [];

loadProduction(function(rows) {
    allRows = rows;
    setupWellSelector(allRows, updateScreening);
});

function updateScreening(wellName) {
    const wellData = allRows.filter(r => r.well === wellName);
    if (wellData.length === 0) return;

    const dates = wellData.map(r => isoDate(r.t));
    const oilRate = wellData.map(r => r.oil * SM3_TO_BBL);
    const bhp = wellData.map(r => r.bhp);

    // Screen on the last day the well produced oil, not the last row (often a shut-in day)
    const oilDays = wellData.filter(r => r.oil > 0);
    const last = oilDays[oilDays.length - 1];

    document.getElementById("wellName").innerText = wellName;
    const statusEl = document.getElementById("drawdownStatus");

    if (!last) {
        document.getElementById("avgBHP").innerText = "N/A";
        document.getElementById("currentOil").innerText = "No production";
        statusEl.innerText = "No production";
        statusEl.className = "flag-nodata";
    } else {
        const lastOil = last.oil * SM3_TO_BBL;
        document.getElementById("currentOil").innerHTML = fmt(lastOil, 0) + " BOPD" + asOf(last.t);
        document.getElementById("avgBHP").innerHTML = last.bhp !== null
            ? fmt(last.bhp, 1) + " bar" + asOf(last.t)
            : "No gauge data" + asOf(last.t);

        if (last.bhp === null) {
            statusEl.innerText = "Cannot screen (no BHP)";
            statusEl.className = "flag-nodata";
        } else if (last.bhp < BHP_LIMIT && lastOil < OIL_LIMIT) {
            statusEl.innerText = "HIGH CANDIDATE";
            statusEl.className = "flag-high";
        } else {
            statusEl.innerText = "Stable Baseline";
            statusEl.className = "flag-normal";
        }
    }

    // Diagnostics Plot: Pressure vs Production Rate Over Time
    const oilTrace = { x: dates, y: oilRate, name: "Oil Rate (BOPD)", type: "scatter", line: { color: "green" } };
    const bhpTrace = { x: dates, y: bhp, name: "BHP (bar)", type: "scatter", yaxis: "y2", connectgaps: false, line: { color: "red", dash: "dot" } };

    Plotly.newPlot("screeningPlot", [oilTrace, bhpTrace], {
        title: { text: wellName + " Diagnostic Screening Parameters" },
        hovermode: "x unified",
        xaxis: { type: "date" },
        yaxis: { title: { text: "Oil Rate (BOPD)", font: { color: "green" } }, tickfont: { color: "green" } },
        yaxis2: { title: { text: "Downhole Pressure (bar)", font: { color: "red" } }, tickfont: { color: "red" }, overlaying: "y", side: "right" },
        legend: { orientation: "h", y: -0.15 }
    });

    drawHeterogeneity(wellName);
}

// --- Heterogeneity index (HI) ---

const MONTH_NAMES = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const HI_QUADRANTS = {
    optimal:     { label: "Optimal producer",         note: "high oil, low water",  color: "rgba(0,0,200,0.45)",  fill: "rgba(0,0,200,0.04)" },
    highLiquid:  { label: "High-rate producer",       note: "high oil, high water", color: "rgba(0,110,0,0.5)",   fill: "rgba(0,140,0,0.04)" },
    waterShutoff:{ label: "Water shut-off candidate", note: "low oil, high water",  color: "rgba(200,100,0,0.8)", fill: "rgba(255,165,0,0.07)" },
    stimulation: { label: "Stimulation candidate",    note: "low oil, low water",   color: "rgba(200,0,0,0.7)",   fill: "rgba(255,0,0,0.05)" }
};

function hiQuadrant(hiOil, hiWater) {
    if (hiOil >= 0) return hiWater > 0 ? HI_QUADRANTS.highLiquid : HI_QUADRANTS.optimal;
    return hiWater > 0 ? HI_QUADRANTS.waterShutoff : HI_QUADRANTS.stimulation;
}

let hiByWell = null;  // well -> [{month, label, year, hiOil, hiWater}], built once

// Monthly HI for every producer. Daily HI is dominated by shut-ins and choke changes, so each
// well's rate is averaged over the days it produced in the month before comparing with the group.
function buildHeterogeneity(rows) {
    const months = new Map();  // "YYYY-MM" -> well -> {oil, water, days}
    rows.forEach(r => {
        if (!isProducing(r)) return;
        const d = new Date(r.t);
        const key = d.getUTCFullYear() + "-" + String(d.getUTCMonth() + 1).padStart(2, "0");
        if (!months.has(key)) months.set(key, new Map());
        const wells = months.get(key);
        if (!wells.has(r.well)) wells.set(r.well, { oil: 0, water: 0, days: 0 });
        const w = wells.get(r.well);
        w.oil += r.oil;
        w.water += r.water;
        w.days += 1;
    });

    const result = {};
    [...months.keys()].sort().forEach(key => {
        const wells = [...months.get(key).entries()];
        if (wells.length < 2) return;  // one active producer: nothing to compare with

        const rates = wells.map(([well, w]) => ({ well, oil: w.oil / w.days * SM3_TO_BBL, water: w.water / w.days * SM3_TO_BBL }));
        const meanOil = rates.reduce((s, r) => s + r.oil, 0) / rates.length;
        const meanWater = rates.reduce((s, r) => s + r.water, 0) / rates.length;
        if (meanOil <= 0 || meanWater <= 0) return;

        const [y, m] = key.split("-").map(Number);
        rates.forEach(r => {
            (result[r.well] = result[r.well] || []).push({
                month: key,
                label: MONTH_NAMES[m - 1] + " " + y,
                year: y + (m - 0.5) / 12,
                hiOil: r.oil / meanOil - 1,
                hiWater: r.water / meanWater - 1,
                activeWells: rates.length
            });
        });
    });
    return result;
}

function drawHeterogeneity(wellName) {
    if (!hiByWell) hiByWell = buildHeterogeneity(allRows);

    const points = hiByWell[wellName] || [];
    const allPoints = Object.values(hiByWell).flat();
    const hiEl = document.getElementById("hiStatus");

    if (points.length === 0) {
        hiEl.innerText = "No comparable months";
        hiEl.className = "flag-nodata";
        Plotly.newPlot("heterogeneityPlot", [], {
            title: { text: wellName + " Fluid Heterogeneity Performance Plot" },
            annotations: [{ text: "No months where this well and at least one other producer were both flowing", showarrow: false, xref: "paper", yref: "paper", x: 0.5, y: 0.5 }],
            xaxis: { visible: false }, yaxis: { visible: false }
        });
        return;
    }

    const latest = points[points.length - 1];
    const q = hiQuadrant(latest.hiOil, latest.hiWater);
    const sign = v => (v >= 0 ? "+" : "") + v.toFixed(2);
    hiEl.innerHTML = q.label + "<br><small>HI oil " + sign(latest.hiOil) + ", water " + sign(latest.hiWater)
        + " (" + latest.label + ")</small>";
    hiEl.className = (q === HI_QUADRANTS.stimulation || q === HI_QUADRANTS.waterShutoff) ? "flag-high" : "flag-normal";

    // Same axes for every well so positions can be compared; HI cannot go below -1
    const maxOf = vals => vals.reduce((m, v) => v > m ? v : m, 1);
    const xMax = maxOf(allPoints.map(p => p.hiOil)) * 1.08;
    const yMax = maxOf(allPoints.map(p => p.hiWater)) * 1.08;
    const xMin = -1.15, yMin = -1.15;

    const contextTrace = {
        x: allPoints.map(p => p.hiOil), y: allPoints.map(p => p.hiWater),
        mode: "markers", type: "scatter", name: "All producers (monthly)", hoverinfo: "skip",
        marker: { size: 5, color: "rgba(150,150,150,0.25)" }
    };
    const pathTrace = {
        x: points.map(p => p.hiOil), y: points.map(p => p.hiWater),
        text: points.map(p => p.label + " (" + p.activeWells + " active producers)"),
        mode: "lines+markers", type: "scatter", name: wellName + " (monthly)",
        hovertemplate: "%{text}<br>HI oil %{x:.2f}<br>HI water %{y:.2f}<extra></extra>",
        line: { color: "rgba(0,51,102,0.35)", width: 1 },
        marker: {
            size: 7, color: points.map(p => p.year), colorscale: "Viridis",
            colorbar: { title: { text: "Year" }, tickformat: "d", thickness: 12 }
        }
    };
    const latestTrace = {
        x: [latest.hiOil], y: [latest.hiWater], mode: "markers", type: "scatter",
        name: "Latest (" + latest.label + ")", hoverinfo: "skip",
        marker: { size: 15, color: "rgba(0,0,0,0)", line: { color: "crimson", width: 2.5 } }
    };

    const quadrantRect = (x0, y0, x1, y1, fill) => ({ type: "rect", layer: "below", x0, y0, x1, y1, fillcolor: fill, line: { width: 0 } });
    const quadrantLabel = (x, y, qd) => ({ x, y, text: "<b>" + qd.label + "</b><br>(" + qd.note + ")", showarrow: false, font: { color: qd.color, size: 11 } });

    Plotly.newPlot("heterogeneityPlot", [contextTrace, pathTrace, latestTrace], {
        title: { text: wellName + " Fluid Heterogeneity Performance Plot" },
        hovermode: "closest",
        xaxis: { title: { text: "Oil Heterogeneity Index (HI oil)" }, range: [xMin, xMax], zeroline: true, zerolinecolor: "#333", zerolinewidth: 2 },
        yaxis: { title: { text: "Water Heterogeneity Index (HI water)" }, range: [yMin, yMax], zeroline: true, zerolinecolor: "#333", zerolinewidth: 2 },
        shapes: [
            quadrantRect(xMin, yMin, 0, 0, HI_QUADRANTS.stimulation.fill),
            quadrantRect(xMin, 0, 0, yMax, HI_QUADRANTS.waterShutoff.fill),
            quadrantRect(0, 0, xMax, yMax, HI_QUADRANTS.highLiquid.fill),
            quadrantRect(0, yMin, xMax, 0, HI_QUADRANTS.optimal.fill)
        ],
        annotations: [
            quadrantLabel(xMin / 2, yMin / 2, HI_QUADRANTS.stimulation),
            quadrantLabel(xMin / 2, yMax * 0.85, HI_QUADRANTS.waterShutoff),
            quadrantLabel(xMax * 0.8, yMax * 0.85, HI_QUADRANTS.highLiquid),
            quadrantLabel(xMax * 0.8, yMin / 2, HI_QUADRANTS.optimal)
        ],
        legend: { orientation: "h", y: -0.18 },
        margin: { t: 50, r: 30, b: 80, l: 70 }
    });
}
</script>

</body>
</html>
